# ----------------------------------------------------------------------------
# Provider-agnostic model routing.
#
# All LLM/embedding access goes through app/llm/. No provider is hard-coded
# anywhere else. Switching from MiniMax today to OpenAI or SynapticaAI later is
# a change to these variables ONLY — never a code change.
# ----------------------------------------------------------------------------

# --- Chat model ---
# CHAT_PROVIDER selects the wire protocol:
#   anthropic -> uses the Anthropic SDK (MiniMax-M3 today)
#   openai    -> uses the OpenAI SDK (OpenAI / SynapticaAI / MiniMax OpenAI-mode)
CHAT_PROVIDER=anthropic
CHAT_MODEL=MiniMax-M3
CHAT_BASE_URL=https://api.minimax.io/anthropic
CHAT_API_KEY=your-minimax-api-key-here
CHAT_MAX_TOKENS=2000
CHAT_TEMPERATURE=0.0

# To switch to OpenAI / SynapticaAI later, set:
#   CHAT_PROVIDER=openai
#   CHAT_MODEL=gpt-4o-mini            (or your SynapticaAI model id)
#   CHAT_BASE_URL=https://api.openai.com/v1   (or your SynapticaAI base url)
#   CHAT_API_KEY=...

# --- Embedding model ---
# EMBEDDINGS_PROVIDER selects the backend:
#   local  -> fastembed, runs offline, no API key, deterministic for CI (default)
#   openai -> any OpenAI-compatible /embeddings endpoint (OpenAI, MiniMax, SynapticaAI)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# When EMBEDDINGS_PROVIDER=openai, also set:
#   EMBEDDINGS_MODEL=text-embedding-3-small   (1536 dims) — and EMBEDDING_DIM=1536
#   EMBEDDINGS_BASE_URL=https://api.openai.com/v1
#   EMBEDDINGS_API_KEY=...
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# ----------------------------------------------------------------------------
# Datastore
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:5432/clinical

# ----------------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
# Cosine-distance ceiling for a chunk to count as evidence (0=identical .. 2=opposite).
# Chunks farther than this are dropped, so off-topic / out-of-record questions
# retrieve nothing and the system abstains. Calibrated for bge-small-en-v1.5
# (relevant ~0.24-0.34, off-topic ~0.42+). Set to 2.0 to disable the gate.
RETRIEVAL_MAX_DISTANCE=0.40
